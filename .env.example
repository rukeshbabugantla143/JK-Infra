# Copy to .env.local for local work, and set the same values in Vercel.
# Every value is optional: the site runs as a clearly marked demo until they are set.

# Public site URL, without a trailing slash, e.g. https://www.your-domain.in
# Used for canonical, Open Graph and sitemap URLs.
# While this is empty the site asks search engines not to index it, so demo content stays out of search.
NEXT_PUBLIC_SITE_URL=

# Verified business WhatsApp number in international format, digits only, e.g. 9198XXXXXXXX
# When empty, the WhatsApp button still opens the prepared message and lets the visitor pick a chat.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Verified public contact details. These appear on the page and in structured data once set.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-side delivery endpoint for enquiries (for example an email service, CRM or automation webhook).
# Each valid enquiry is POSTed to this URL as JSON.
# While this is empty, the contact form is labelled as a demo and nothing is delivered or stored.
ENQUIRY_WEBHOOK_URL=
